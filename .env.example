# Copier vers .env et remplir
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/music_news_radar

# Scoring Claude (étape 4) — clé à créer sur console.anthropic.com
# ANTHROPIC_API_KEY=
# SCORING_MODEL=claude-haiku-4-5      # défaut ; passer à claude-sonnet-5 si besoin
# DIGEST_RELEVANCE_THRESHOLD=60
# ALERT_HOTNESS_THRESHOLD=80

# X via l'API officielle v2 (pay-per-use ~0,005 $/tweet lu, since_id natif)
# Token : developer.x.com (nécessite la facturation pay-per-use activée)
# X_BEARER_TOKEN=
# X_MAX_ITEMS=50                    # max_results par requête (borne API : 5-100)

# Alternative Apify (nécessite un plan Apify payant — non utilisée par défaut)
# APIFY_TOKEN=
# APIFY_MAX_CHARGE_USD=0.25

# Source Instagram (business_discovery, gratuit) — jeton utilisateur FACEBOOK
# (EAA..., 60 jours une fois etendu, renouvellement a la main). Distinct de
# META_ACCESS_TOKEN (connexion Instagram, publication) ; absent = sources IG sautees.
# META_FB_ACCESS_TOKEN=
# INSTAGRAM_MAX_ITEMS=12        # posts lus par compte cible et par run
# INSTAGRAM_INTERVALLE_HEURES=1 # espacement entre deux lectures d'un même compte

# Veille rapide (agent com.musicnewsradar.veille, toutes les 5 min) : une LISTE
# COURTE de comptes relus à la minute, tout le reste garde la cadence horaire.
# 12 comptes = 144 appels Graph/h ; les lire TOUS toutes les 5 min en ferait
# 1 476, soit 3,4x le plafond observé (~430/h ont rendu le code 4 le 2026-09-17).
# Chaque compte ajouté coûte 12 appels/h sur un quota PARTAGÉ avec la publication.
# VEILLE_COMPTES=stmpdrcrds,defectedrecords,vladimircauchemar,fredagainagainagainagainagain,etjusticepourtous,edbanger,astropolis,nuits_sonores,transmusicales,positiveeducation,madeon,worakls.music
# VEILLE_INTERVALLE_MINUTES=5
# VEILLE_APPELS_MAX_PAR_HEURE=200   # plafond dur de la veille seule
# VEILLE_PAUSE_QUOTA_MINUTES=30     # pause après un code de quota Meta (4/17/32/613)
# VEILLE_SCORING_MAX=20             # articles scorés au plus par passage

# Regroupement des doublons : une actu couverte par au moins N sources DISTINCTES
# passe toujours chez Claude, même sous le seuil du pré-filtre local. Et borne des
# réélections de représentant + remises à noter par run (un appel Claude chacune).
# CLUSTER_SOURCES_CLAUDE=3
# CLUSTER_REEVALUATIONS_MAX_PAR_RUN=10

# Visuels d'artistes (jamais ceux d'un compte Instagram de catégorie media)
# Un post d'artiste plus vieux que N jours que l'article n'est jamais pris ;
# hors sujet (portrait, live), il n'est accepté qu'à N jours de l'actu.
# VISUELS_ARTISTE_FENETRE_JOURS=10
# VISUELS_ARTISTE_GENERIQUE_JOURS=5
# VISUELS_MAX_PHOTOS=3              # photos d'artiste au plus dans un carrousel
# Lectures business_discovery en direct à la composition : le quota Graph est
# partagé avec le pipeline et a déjà rendu le code 4 pendant une heure.
# VISUELS_LECTURES_MAX_PAR_PASSAGE=2
# VISUELS_LECTURES_MAX_PAR_JOUR=24
# VISUELS_CACHE_LECTURES_HEURES=6   # cache par handle d'une lecture en direct
# VISUELS_PAUSE_QUOTA_MINUTES=60    # pause après un code Graph 4/17/32/613
# Copies locales des images d'artistes (les URL du CDN Instagram expirent) et
# ménage de ce cache.
# VISUELS_CACHE_DIR=~/Library/Application Support/Kinda/visuels
# VISUELS_CACHE_JOURS=7

# --- Fond de cover : une illustration, jamais une affiche -------------------
# Un juge visuel (Claude vision, ~1 400 jetons par composition) classe les images
# candidates avant d'en faire le fond de la cover. À false : on garde la première
# image exploitable, le comportement d'avant le 2026-09-18.
# ILLUSTRATION_VISION_ENABLED=true
# VISUELS_MODEL=claude-haiku-4-5    # « affiche ou photo ? » n'exige pas mieux
# ILLUSTRATION_MAX_CANDIDATS=3
# ILLUSTRATION_TAILLE_PX=512        # le coût d'une image suit sa SURFACE
# ILLUSTRATION_CACHE_PATH=~/Library/Application Support/Kinda/illustrations.json
# ILLUSTRATION_CACHE_JOURS=7
# Quand TOUS les candidats sont des affiches (carrousel de line-up), on va
# chercher des photos sur le compte qui a publié l'actu. Chacune coûte un
# téléchargement et des jetons de vision.
# FOND_SECOURS_MAX_PHOTOS=2
# DERNIER recours avant le fond Kinda : une recherche web (outil `web_search` de
# l'API Anthropic) puis l'og:image des pages trouvées. Une recherche par requête,
# mémorisée quelques jours. À false, retour exact au comportement d'avant.
# VISUELS_WEB_ENABLED=true
# VISUELS_WEB_MAX_CANDIDATS=3
# VISUELS_WEB_CACHE_PATH=~/Library/Application Support/Kinda/visuels_web.json
# VISUELS_WEB_CACHE_JOURS=3

# --- Optionnels, désactivés par défaut ---
# Alertes Discord : le pipeline saute l'étape quand la variable est absente
# (app/pipeline/run.py). Le code reste en place (app/delivery/discord.py,
# scripts/send_hot_alerts.py) — renseigner l'URL suffit à les réactiver.
# DISCORD_WEBHOOK_URL=          # alertes hot (hotness >= 80)
# SMTP_HOST=                    # digest mail (jamais planifié)
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# DIGEST_TO=

# Instagram : jeton IG... (60 jours) et identifiant du compte, depuis l'app Meta
# META_ACCESS_TOKEN=
# META_IG_USER_ID=
# Publication automatique : arret (defaut, l'agent sort sans rien faire),
# apercu (tout sauf la publication chez Meta), reel (publie : public et
# irreversible, decision de l'utilisateur). Valeur de repli SEULEMENT : le mode
# reellement applique se choisit dans le dashboard (panneau Programmation) et
# vit dans publication.json a cote du jeton Instagram -- cette ligne ne compte
# que tant qu'aucun choix n'a ete fait depuis le dashboard.
# PUBLICATION_MODE=arret
# Secondes d'avance : conteneur cree d'avance, publication a l'heure affichee.
# PUBLICATION_AVANCE_S=660
# Cadrage des images du carrousel : toutes sortent en 1080x1350 (le format de la
# cover, qu'Instagram impose ensuite a tout le carrousel). Une image qu'il
# faudrait agrandir plus de 2,2 fois pour remplir ce cadre, ou dont le recadrage
# jetterait plus de 60 % de la surface (panoramique, bandeau), est ECARTEE du
# carrousel plutot que publiee massacree.
# PUBLICATION_CROP_UPSCALE_MAX=2.2
# PUBLICATION_CROP_PERTE_MAX=0.60

# Fenetres carrousel (heure de Paris), separees par des virgules : une fenetre =
# un carrousel par jour, l'heure exacte y est tiree au hasard. Changer cette
# liste change le nombre de posts quotidiens -- sans toucher au code. Aucune ne
# doit chevaucher une fenetre reel (ci-dessous) : l'heure de publication est
# unique tous formats confondus.
# PUBLICATION_FENETRES=08:30-10:30,14:30-16:30,19:00-20:15
# Nombre de creneaux carrousel tenus d'avance : 3 jours x 3 fenetres.
# PUBLICATION_CRENEAUX=9
# REPLI d'un .env d'avant la generalisation : ces deux lignes ne servent que si
# PUBLICATION_FENETRES est VIDE. Un .env qui les porte encore doit passer a
# PUBLICATION_FENETRES, sinon elles sont ignorees.
# PUBLICATION_FENETRE_MATIN=
# PUBLICATION_FENETRE_APRES_MIDI=

# Reels automatiques (0 creneau = pas de reels)
# PUBLICATION_CRENEAUX_REEL=9
# PUBLICATION_REEL_FENETRES=11:00-12:30,17:00-18:30,21:00-22:30
# PUBLICATION_REEL_CATEGORIES=artiste,festival,label,club
# Duree de la video (s) : sous le minimum, pas de reel ; au-dessus du maximum,
# refusee, jamais coupee.
# PUBLICATION_REEL_DUREE_MIN_S=3
# PUBLICATION_REEL_DUREE_MAX_S=90
# Poids max (Mo) de la video source telechargee et du reel assemble
# PUBLICATION_REEL_SOURCE_MAX_MO=100
# PUBLICATION_REEL_MAX_MO=100
# Le reel apparait aussi dans la grille du compte
# PUBLICATION_REEL_SHARE_TO_FEED=true
# yt-dlp pour les reels sans lien direct (false = videos de l'API seulement)
# PUBLICATION_REEL_YTDLP=true
# Les reels eux-memes restent COUPES tant que la case « Reels auto » du
# dashboard n'a pas ete cochee (opt-in, publication.json).
